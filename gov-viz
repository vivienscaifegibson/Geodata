##### 3.7) Board organigram (leaflet) #####
# Needs Iss_Gov_Dir_Gen (one row per director).
# Drag to move, scroll to zoom. The cards grow and shrink with the zoom.

library(dplyr)
library(htmltools)
library(leaflet)

# ---- COLUMNS ---------------------------------------------------------------------
# The first column name that exists is used, otherwise the column is guessed from
# its name. If a guess is wrong, set it by hand, e.g. org_cols$name <- "fullname"
org_pick <- function(candidates, pattern = NULL, exclude = "issuer|company|committee|avg|policy|ratio|noof",
                     text_only = FALSE) {
  nm  <- names(Iss_Gov_Dir_Gen)
  hit <- candidates[candidates %in% nm]
  if (length(hit)) return(hit[1])
  if (is.null(pattern)) return(NA_character_)
  nm <- nm[grepl(pattern, nm, ignore.case = TRUE) & !grepl(exclude, nm, ignore.case = TRUE)]
  if (text_only) nm <- nm[vapply(nm, function(v) !is.numeric(Iss_Gov_Dir_Gen[[v]]), logical(1))]
  if (length(nm) == 0) return(NA_character_)
  nm[which.max(vapply(nm, function(v) n_distinct(Iss_Gov_Dir_Gen[[v]]), numeric(1)))]
}

org_cols <- list(
  name   = org_pick(character(0), "name", text_only = TRUE,
                    exclude = "issuer|company|committee|first|last|given|middle|sur|family|vor|nach"),
  first  = org_pick(character(0), "^first|^given|vorname", text_only = TRUE),   # only used without a full name
  last   = org_pick(character(0), "^last|^sur|^family|nachname", text_only = TRUE),
  role   = org_pick(character(0), "role|title|position|function", text_only = TRUE),
  # classification that forms the columns of the organigram: ISS first, then the company's own
  group  = org_pick(c("iss_affiliation_classification", "dirclassificationpas",
                      "company_affiliation_classification", "dirclassificationco")),
  age    = org_pick("age", "^age$|director_?age"),
  gender = org_pick("gender", "gender|sex"),
  tenure = org_pick("tenure", "tenure")
)

# ---- CLASSIFICATION CODES --------------------------------------------------------
# order = order of the columns from left to right; colour = one colour per type of director
org_class <- tribble(
  ~code,          ~label,                                    ~colour,
  "Exec",         "Executive",                               "#2a78d6",   # executives: blue
  "I",            "Insider",                                 "#2a78d6",
  "NEI",          "Non-Executive Insider",                   "#eb6834",   # not independent: orange
  "NI-NED",       "Non-Independent Non-Executive Director",  "#eb6834",
  "AO",           "Affiliated Outsider",                     "#eb6834",
  "ER",           "Employee Representative",                 "#6250d6",   # employee side: violet
  "ESR",          "Employee Shareholder Representative",     "#6250d6",
  "IO",           "Independent Outsider",                    "#1baf7a",   # independent: green
  "I-NED",        "Independent Non-Executive Director",      "#1baf7a",
  "UO",           "Unclassified Outsider",                   "#7a7972",   # unclassified: grey
  "Unclassified", "Unclassified",                            "#7a7972"
)

# ---- FLAGS: Yes/No columns shown as tags on the director card ---------------------
# type: "good" = green, "bad" = red, "neutral" = grey
org_flags <- tribble(
  ~column,                              ~label,                     ~type,
  "isdisclosedasfinancialexpert",       "Financial expert",         "good",
  "isformernoninterimceo",              "Former CEO",               "neutral",
  "isformeremployee",                   "Former employee",          "neutral",
  "providesprofservice",                "Provides prof. services",  "bad",
  "hasrelativeincompservingasexec",     "Relative is executive",    "bad",
  "hasboardinterlockrelwithcompexec",   "Board interlock",          "bad"
)

# ---- HELPERS ---------------------------------------------------------------------
org_yes <- function(x) {
  if (is.numeric(x) || is.logical(x)) return(!is.na(x) & as.numeric(x) == 1)
  tolower(trimws(as.character(x))) %in% c("yes", "y", "true", "1")
}

org_gender <- function(x) {
  y <- tolower(trimws(as.character(x)))
  case_when(is.na(x) | y == ""                  ~ NA_character_,
            substr(y, 1, 1) %in% c("f", "w")    ~ "Female",
            substr(y, 1, 1) == "m"              ~ "Male",
            TRUE                                ~ as.character(x))
}

org_initials <- function(x) {
  vapply(strsplit(gsub("[^[:alpha:] -]", "", x), "[ -]+"), function(p) {
    p <- p[nchar(p) > 0]
    toupper(paste0(substr(p[1], 1, 1), if (length(p) > 1) substr(p[length(p)], 1, 1) else ""))
  }, character(1))
}

