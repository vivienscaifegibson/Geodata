##### 3.7) Board organigram #####
# Needs Iss_Gov_Dir_Gen (one row per director). Run after the governance score script,
# then the total score is shown in the company box as well.

library(dplyr)
library(htmltools)

# ---- COLUMNS ---------------------------------------------------------------------
# name and role are guessed from the column names. If a guess is wrong, write the
# column name in here by hand, e.g. org_cols$name <- "fullname"
org_guess <- function(pattern, exclude = "issuer|company|committee") {
  nm <- names(Iss_Gov_Dir_Gen)
  nm <- nm[grepl(pattern, nm, ignore.case = TRUE) & !grepl(exclude, nm, ignore.case = TRUE)]
  nm <- nm[vapply(nm, function(v) !is.numeric(Iss_Gov_Dir_Gen[[v]]), logical(1))]
  if (length(nm) == 0) return(NA_character_)
  nm[which.max(vapply(nm, function(v) n_distinct(Iss_Gov_Dir_Gen[[v]]), numeric(1)))]
}

org_cols <- list(
  name   = org_guess("name", "issuer|company|committee|first|last|given|middle|sur|family|vor|nach"),  # director name
  first  = org_guess("^first|^given|vorname"),                   # only used if there is no full name
  last   = org_guess("^last|^sur|^family|nachname"),
  role   = org_guess("role|title|position|function"),            # e.g. Chair, CEO, Lead Director
  group  = "dirclassificationpas",                               # columns of the organigram
  age    = "age",
  gender = "gender",
  tenure = "tenure"
)

# Yes/No columns shown as small tags on the director card
org_flags <- c(isdisclosedasfinancialexpert     = "Financial expert",
               isformernoninterimceo            = "Former CEO",
               isformeremployee                 = "Former employee",
               providesprofservice              = "Provides prof. services",
               hasrelativeincompservingasexec   = "Relative is executive",
               hasboardinterlockrelwithcompexec = "Board interlock")

# ---- HELPERS ---------------------------------------------------------------------
org_yes <- function(x) {
  if (is.numeric(x) || is.logical(x)) return(!is.na(x) & as.numeric(x) == 1)
  tolower(trimws(as.character(x))) %in% c("yes", "y", "true", "1")
}

org_gender <- function(x) {
  y <- tolower(trimws(as.character(x)))
  case_when(is.na(x) | y == ""                  ~ NA_character_,
            substr(y, 1, 1) %in% c("f", "w")    ~ "Female",
            substr(y, 1, 1) == "m"              ~ "Male",
            TRUE                                ~ as.character(x))
}

# executives first, independent directors last
org_group_rank <- function(x) {
  y <- tolower(x)
  case_when(grepl("indep", y) & !grepl("non|not", y)       ~ 3,
            grepl("insider|^exec", y)                      ~ 1,
            TRUE                                           ~ 2)
}

org_initials <- function(x) {
  vapply(strsplit(gsub("[^[:alpha:] -]", "", x), "[ -]+"), function(p) {
    p <- p[nchar(p) > 0]
    toupper(paste0(substr(p[1], 1, 1), if (length(p) > 1) substr(p[length(p)], 1, 1) else ""))
  }, character(1))
}

