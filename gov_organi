# ---- PLOT --------------------------------------------------------------------------
# company  = issuername
# max_rows = cards below each other before a group starts a second column
plot_board_organigram <- function(company, max_rows = 4) {

  d <- Iss_Gov_Dir_Gen %>% filter(issuername == company)
  d <- d %>% filter(isin == d$isin[1])

  col <- function(key) {                       # column as vector, NA if the column does not exist
    v <- org_cols[[key]]
    if (is.null(v) || is.na(v) || !v %in% names(d)) rep(NA, nrow(d)) else d[[v]]
  }

  nm <- as.character(col("name"))
  if (all(is.na(nm))) nm <- trimws(paste(coalesce(as.character(col("first")), ""),
                                         coalesce(as.character(col("last")), "")))
  nm[is.na(nm) | nm == ""] <- paste("Director", seq_len(nrow(d)))[is.na(nm) | nm == ""]

  dir <- tibble(
    name   = nm,
    role   = as.character(col("role")),
    group  = coalesce(as.character(col("group")), "Board of Directors"),
    age    = suppressWarnings(as.numeric(col("age"))),
    gender = org_gender(col("gender")),
    tenure = suppressWarnings(as.numeric(col("tenure")))
  )
  dir$tags <- lapply(seq_len(nrow(d)), function(i) {
    f <- intersect(names(org_flags), names(d))
    unname(org_flags[f][vapply(f, function(v) org_yes(d[[v]][i]), logical(1))])
  })

  dir <- dir %>%
    distinct(name, .keep_all = TRUE) %>%
    mutate(lead = case_when(grepl("chair", role, ignore.case = TRUE) & !grepl("vice|deputy", role, ignore.case = TRUE) ~ 1,
                            grepl("ceo|chief executive", role, ignore.case = TRUE) ~ 2,
                            TRUE ~ 3)) %>%
    arrange(org_group_rank(group), group, lead, name)

  # colour follows the type of group: executives blue, non-independent orange, independent green
  groups <- unique(dir$group)
  pool   <- c("#2a78d6", "#eb6834", "#1baf7a", "#6250d6", "#e87ba4", "#eda100")
  accent <- character(0)
  for (g in groups) {
    want <- pool[org_group_rank(g)]
    accent[g] <- if (!want %in% accent) want else c(setdiff(pool, accent), want)[1]
  }

  # company box
  stat <- function(value, label) div(class = "org-stat", tags$b(value), span(label))
  fmt  <- function(x, digits = 0) if (is.na(x) || is.nan(x)) "n/a" else format(round(x, digits), nsmall = digits)
  score <- if (exists("Gov_Total")) Gov_Total$score_total[Gov_Total$isin == d$isin[1]][1] else NA
  stats <- list(
    stat(nrow(dir), "directors"),
    stat(if (all(is.na(dir$gender))) "n/a" else paste0(fmt(100 * mean(dir$gender == "Female", na.rm = TRUE)), "%"), "women"),
    stat(fmt(mean(dir$age, na.rm = TRUE)), "average age"),
    stat(fmt(mean(dir$tenure, na.rm = TRUE), 1), "average tenure (years)")
  )
  if (!is.na(score)) stats <- c(stats, list(
    stat(span(class = "org-score",
              style = paste0("background:", sev_fill(score), ";color:", sev_ink(score)), fmt(score, 1)),
         "governance score")))

  top <- div(class = "org-top", div(class = "org-sub", "Board of Directors"), tags$h1(company),
             div(class = "org-stats", stats))

  # one director card
  card <- function(i, colr) {
    r <- dir[i, ]
    meta <- c(if (!is.na(r$age)) paste(fmt(r$age), "years"),
              if (!is.na(r$gender)) r$gender)
    tenure <- if (!is.na(r$tenure)) paste(fmt(r$tenure, if (r$tenure %% 1 == 0) 0 else 1), "years on board")
    div(class = "org-card", style = paste0("border-left-color:", colr),
        div(class = "org-av", style = paste0("background:", colr), org_initials(r$name)),
        div(div(class = "org-name", r$name),
            if (!is.na(r$role) && r$role != "") div(class = "org-role", r$role),
            if (length(meta)) div(class = "org-meta", paste(meta, collapse = ", ")),
            if (length(tenure)) div(class = "org-meta", style = "margin-top:1px", tenure),
            if (length(r$tags[[1]])) div(class = "org-tags", lapply(r$tags[[1]], function(t) span(class = "org-tag", t)))))
  }

  # one column per group
  grp <- lapply(groups, function(g) {
    idx <- which(dir$group == g)
    div(class = "org-grp",
        div(class = "org-head", style = paste0("background:", accent[[g]]), g, span(length(idx))),
        div(class = "org-cards",
            style = paste0("grid-template-columns: repeat(", ceiling(length(idx) / max_rows), ", auto)"),
            lapply(idx, card, colr = accent[[g]])))
  })

  browsable(tagList(
    tags$style(HTML(org_css)),
    div(class = "org", div(class = "org-tree", top, div(class = "org-stem"), div(class = "org-row", grp)))
  ))
}

