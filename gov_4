##### 3.6) Sunburst plot #####

# severity bands for a 0-100 score
sev_fill <- function(score) {
  case_when(is.na(score) ~ "#d9d8d2",   # no data
            score >= 75  ~ "#0ca30c",   # good
            score >= 50  ~ "#fab219",   # warning
            score >= 25  ~ "#ec835a",   # serious
            TRUE         ~ "#d03b3b")   # critical
}
sev_ink <- function(score) if_else(is.na(score) | (score >= 25 & score < 75), "#0b0b0b", "#ffffff")

criterion_lab <- c(pct100   = "SCALE 1:100",
                   calc_pct = "CALC PERCENTAGE",
                   binary   = "YES / NO",
                   has_any  = "YES / NO (count > 0)",
                   cutoff   = paste0("SCALE 1:100, cutoff ", 100 * women_cutoff, "%"),
                   indep    = "INDEPENDENT YES / NO",
                   ordinal  = "LEVEL (min-max)")

pct_lab <- function(w) paste0(format(round(100 * w, 1), nsmall = 1, trim = TRUE), "%")
num_lab <- function(x) if_else(is.na(x), "no data", format(round(x, 1), nsmall = 1, trim = TRUE))

# company  = issuername shown in the middle
# category = optional, opens the plot zoomed into one category (same as clicking on it)
plot_gov_sunburst <- function(company, category = NULL) {

  zoom <- category
  id   <- Gov_Firm$isin[Gov_Firm$issuername == company][1]
  tot  <- Gov_Total       %>% filter(isin == id)
  vars <- Gov_Var_Scores  %>% filter(isin == id)
  rows <- Iss_Gov_Dir_Gen %>% filter(isin == id)
  # every category of the company gets a node, also one without any usable data (grey)
  cats <- vars %>%
    distinct(category, weight_cat) %>%
    left_join(Gov_Cat_Long %>% filter(isin == id) %>% select(category, score), by = "category")

  # realisation = value as it stands in the data (first non-missing row of the company)
  realisation <- function(v) {
    x <- rows[[v]]
    x <- x[!is.na(x)][1]
    if (is.numeric(x)) as.character(round(x, 2)) else as.character(x)
  }
  vars$realisation <- vapply(vars$variable, realisation, character(1))

  # centre: company + total score
  root <- tibble(
    id = "root", parent = "", size = 0, score = c(tot$score_total, NA)[1],
    text = paste0("<b>", company, "</b><br>Governance Score<br><b>", num_lab(score), "</b>")
  )

  # inner ring: categories with weight + score
  cat_nodes <- cats %>%
    transmute(
      id = category, parent = "root", size = 0, score,
      text = paste0("<b>", category, "</b>",
                    "<br>Weight: ", pct_lab(weight_cat),
                    "<br>Score: ", num_lab(score))
    )

  # outer ring: variables with weight, score, criterion and realisation
  var_nodes <- vars %>%
    transmute(
      id = paste(category, variable, sep = " / "), parent = category, size = weight, score,
      text = paste0("<b>", variable, "</b>",
                    "<br>Weight: ", pct_lab(weight), " | Score: ", num_lab(score),
                    "<br>", criterion_lab[treat],
                    if_else(dir == 1, " (high = good)", " (high = bad)"),
                    if_else(ranked, " | RANKED", ""),
                    if_else(category == "Sustainability Oversight", " | ADD ON", ""),
                    "<br>Value: ",
                    case_when(is.na(value) ~ "no data",
                              agg == "max" ~ if_else(value == 1, "Yes (any director)", "No (no director)"),
                              TRUE ~ realisation))
    )

  nodes <- bind_rows(root, cat_nodes, var_nodes)

  plot_ly(
    type    = "sunburst",
    ids     = nodes$id,
    labels  = nodes$id,
    parents = nodes$parent,
    values  = nodes$size,             # only the variables carry a size -> full circle
    level   = if (is.null(zoom)) "root" else zoom,
    text    = nodes$text,
    textinfo  = "text",               # no label + text -> nothing is doubled
    hoverinfo = "none",               # no hover
    sort = FALSE,
    insidetextorientation = "radial",
    marker   = list(colors = sev_fill(nodes$score), line = list(color = "#ffffff", width = 2)),
    leaf     = list(opacity = 1),
    textfont = list(color = sev_ink(nodes$score))
  ) %>%
    layout(margin = list(t = 10, l = 10, r = 10, b = 10))
}

plot_gov_sunburst("Microsoft Corporation")
