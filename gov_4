# sd near 0 or missing above ~0.5 -> the variable adds nothing
Gov_Var_Check <- Gov_Var_Scores %>%
  group_by(category, variable) %>%
  summarise(missing = mean(is.na(score)),
            sd      = sd(score, na.rm = TRUE),
            at_0    = mean(score == 0, na.rm = TRUE),
            at_100  = mean(score == 100, na.rm = TRUE),
            .groups = "drop") %>%
  arrange(sd)

