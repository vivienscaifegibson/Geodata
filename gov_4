##### 3.4) Create Gov Score #####

library(dplyr)
library(tidyr)
library(plotly)

# - Join Director / Quali data

Iss_Gov_Dir_Gen <- ISS_PORT_GOV_DIR_adap %>%
  left_join(ISS_PORT_GOV_QUAL_adap %>%
              select(-c(gicssubindustry, gicssector, gicsindustrygroup, gicsindustry,
                        issuername, countryofincorporation)),
            by = "isin")

women_cutoff <- 0.40
scale_mode   <- "rank"   # "rank" = percentages are ranked across all companies (relative score)
                         # "raw"  = percentages are used as they are (absolute score)

# ---- SPEC: one row per variable, one variable per concept --------------------------
# treat: pct100   = SCALE 1:100
#        calc_pct = CALC PERCENTAGE (count / board size)
#        binary   = YES / NO
#        has_any  = YES / NO (count > 0)
#        indep    = YES / NO (classification text says "independent")
#        cutoff   = SCALE 1:100, full score from women_cutoff upwards
#        ordinal  = level, min-max scaled over all companies
# dir  :  1 = higher is better, -1 = higher is worse
# With scale_mode "rank", pct100 and calc_pct become: share of companies that are not better.
spec <- tribble(
  ~variable,                            ~treat,     ~dir,
