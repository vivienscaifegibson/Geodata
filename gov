# ---- 2. CHECKS ---------------------------------------------------------------
miss_data  <- setdiff(spec$variable, names(data_in))
miss_categ <- setdiff(spec$variable, categ_in$variable)
if (length(miss_data))  warning("In spec but NOT a column of Iss_Gov_Dir_Gen: ",
                                paste(miss_data, collapse = ", "))
if (length(miss_categ)) warning("In spec but NOT in Governance_Categ_adap: ",
                                paste(miss_categ, collapse = ", "))
spec <- filter(spec, variable %in% names(data_in), variable %in% categ_in$variable)

# ---- 3. CLEAN VALUES -> NUMERIC ----------------------------------------------
to_num <- function(x) {
  if (is.numeric(x)) return(as.numeric(x))
  if (is.logical(x)) return(as.numeric(x))
  y <- str_to_lower(str_trim(as.character(x)))
  out <- suppressWarnings(as.numeric(y))
  out[y %in% c("yes", "y", "true")]       <- 1
  out[y %in% c("no", "n", "false")]       <- 0
  out[y %in% c("low")]                    <- 1   # ordinal levels (ceopayptaconcernlevel)
  out[y %in% c("medium", "moderate")]     <- 2
  out[y %in% c("high")]                   <- 3
  out[y %in% c("very high", "severe")]    <- 4
  out
}
agg_fun <- function(v, how) {
  if (all(is.na(v))) return(NA_real_)
  if (how == "max") max(v, na.rm = TRUE) else mean(v, na.rm = TRUE)
}

# ---- 4. DIRECTOR ROWS -> ONE ROW PER COMPANY ---------------------------------
vars_mean <- spec$variable[spec$agg == "mean"]
vars_max  <- spec$variable[spec$agg == "max"]

firm <- data_in %>%
  group_by(across(all_of(id_cols))) %>%
  summarise(
    board_size = n(),                                   # number of director rows
    across(all_of(vars_mean), ~ agg_fun(to_num(.x), "mean")),
    across(all_of(vars_max),  ~ agg_fun(to_num(.x), "max")),
    .groups = "drop"
  )

# ---- 5. SCORE EVERY VARIABLE 0-1 (1 = best) ----------------------------------
var_scores <- firm %>%
  pivot_longer(all_of(spec$variable), names_to = "variable", values_to = "raw") %>%
  left_join(spec, by = "variable") %>%
  group_by(variable) %>%
  mutate(
    all_na = all(is.na(raw)),
    p_guard = if (all_na[1]) 1 else if (max(raw, na.rm = TRUE) > 1) 100 else 1,  # 0-1 or 0-100?
    rng_min = suppressWarnings(min(raw, na.rm = TRUE)),
    rng_max = suppressWarnings(max(raw, na.rm = TRUE))
  ) %>%
  ungroup() %>%
  mutate(
    s = case_when(
      treat == "binary"   ~ raw,
      treat == "has_any"  ~ as.numeric(raw > 0),
      treat == "pct100"   ~ raw / p_guard,
      treat == "calc_pct" ~ raw / board_size,
      treat == "cutoff"   ~ pmin((raw / p_guard) / women_cutoff, 1),
      treat == "decile"   ~ (raw - 1) / 9,
      treat == "ordinal"  ~ if_else(rng_max > rng_min, (raw - rng_min) / (rng_max - rng_min), NA_real_),
      TRUE                ~ NA_real_
    ),
    s = pmin(pmax(s, 0), 1),
    score = if_else(dir == -1, 1 - s, s)
  ) %>%
  select(all_of(id_cols), variable, treat, dir, raw, score)

dead <- var_scores %>% group_by(variable) %>% summarise(n_ok = sum(!is.na(score))) %>%
  filter(n_ok == 0)
if (nrow(dead)) warning("No usable values (check coding/legend) for: ",
                        paste(dead$variable, collapse = ", "))

# ---- 6. CATEGORY SCORE = WEIGHTED MEAN, x100 ---------------------------------
Gov_Var_Scores_long <- var_scores %>%
  left_join(distinct(categ_in, variable, source, category, weight), by = "variable")

n_possible <- Gov_Var_Scores_long %>%
  distinct(variable, category) %>% count(category, name = "n_vars_possible")

Gov_Cat_Scores_long <- Gov_Var_Scores_long %>%
  filter(!is.na(score)) %>%
  group_by(across(all_of(id_cols)), category) %>%
  mutate(w = if (all(is.na(weight)) || sum(weight, na.rm = TRUE) <= 0) 1
             else coalesce(weight, mean(weight, na.rm = TRUE))) %>%
  summarise(
    gov_score   = 100 * sum(w * score) / sum(w),
    n_vars_used = n(),
    .groups = "drop"
  ) %>%
  left_join(n_possible, by = "category") %>%
  mutate(coverage = n_vars_used / n_vars_possible)

Gov_Cat_Scores_wide <- Gov_Cat_Scores_long %>%
  mutate(cat_nm = paste0("score_", str_to_lower(str_replace_all(category, "[^A-Za-z]+", "_")))) %>%
  select(all_of(id_cols), cat_nm, gov_score) %>%
  pivot_wider(names_from = cat_nm, values_from = gov_score)

# ---- 7. QUICK LOOK -----------------------------------------------------------
Gov_Cat_Scores_wide %>% print(n = 10, width = Inf)
Gov_Cat_Scores_long %>% group_by(category) %>%
  summarise(mean = mean(gov_score), sd = sd(gov_score),
            min = min(gov_score), max = max(gov_score),
            coverage = mean(coverage), .groups = "drop") %>%
  print(n = Inf)
