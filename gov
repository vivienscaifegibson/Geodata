# =============================================================================
# PROVISIONAL GOVERNANCE SCORE PER CATEGORY (per company)
# Input : Iss_Gov_Dir_Gen          (n rows per company = one row per director)
#         Governance_Categ_adap    (source, category, variable, description, weight)
# Output: Gov_Cat_Scores_wide      one row per company, one column per category (0-100)
#         Gov_Cat_Scores_long      company x category, with n variables used / coverage
#         Gov_Var_Scores_long      company x variable, scored 0-1 (for auditing)
# Convention: every variable is turned into a 0-1 score where 1 = best governance,
#             then category score = weighted mean (weights from Governance_Categ_adap)
#             x 100. Missing variables are skipped and weights re-normalised.
# =============================================================================
library(dplyr)
library(tidyr)
library(stringr)
library(purrr)
library(tibble)

# ---- 0. SETTINGS -------------------------------------------------------------
id_cols      <- c("companyid")  # <-- CHANGE: company key (add "year" if it is a panel)
women_cutoff <- 0.40            # share of women at/above which ratioofwomenonboarddqs = full score
data_in      <- Iss_Gov_Dir_Gen
categ_in     <- Governance_Categ_adap

if (!all(id_cols %in% names(data_in))) {
  stop("id_cols not found in Iss_Gov_Dir_Gen. Candidates: ",
       paste(grep("id|isin|ticker|company|year", names(data_in), value = TRUE,
                  ignore.case = TRUE), collapse = ", "))
}

# ---- 1. SPEC: what to do with each variable (from your RStudio comments) ------
# treat: binary    = Yes/No (1/0)
#        has_any   = count > 0 -> 1, else 0
#        pct100    = already a 1:100 percentage -> /100
#        calc_pct  = count / board size (= number of director rows of the company)
#        cutoff    = share of women, capped at women_cutoff
#        decile    = ISS QualityScore decile 1-10 (1 = lowest risk) -> (x-1)/9
#        ordinal   = ordered level, min-max scaled over the sample
# dir  : +1 = higher is better, -1 = higher is worse (score is flipped)
# agg  : how director rows collapse to the company: "mean" (default) or "max" (= any)
spec <- tribble(
  ~variable,                          ~treat,     ~dir, ~agg,
  # Board Independence
  "ratioexecutivesonboardco",         "pct100",    -1,  "mean",
  "boardindependenceratioco",         "pct100",     1,  "mean",
  "boardindependenceratiopas",        "pct100",     1,  "mean",
  "ratioindepnonexeconboardco",       "pct100",     1,  "mean",
  "ratioindepnonexeconboardpas",      "pct100",     1,  "mean",
  "ratioindepoutsidersonboardco",     "pct100",     1,  "mean",
  "ratioindepoutsidersonboardpas",    "pct100",     1,  "mean",
  "ratioinsidersonboardco",           "pct100",    -1,  "mean",
  "ratioinsidersonboardpas",          "pct100",    -1,  "mean",
  "noofaffiliateddirectorspas",       "calc_pct",  -1,  "mean",
  "pctinddirectorsinhumancapmgmt",    "pct100",     1,  "mean",
  "relativeempdirectorsratio",        "pct100",    -1,  "mean",
  "boardindependenceratiopasworldqs", "pct100",     1,  "mean",
  # Audit & Controls
  "compensationqualityscoredec",      "decile",    -1,  "mean",
  "overallqualityscoredec",           "decile",    -1,  "mean",
  "shareholderrightsqualityscoredec", "decile",    -1,  "mean",
  "ltiperfmeasuredisclosurees",       "pct100",     1,  "mean",
  "pctinddirectorsinsuccession",      "pct100",     1,  "mean",
  "audcommindependenceratio",         "pct100",     1,  "mean",
  # Board Effectiveness
  "chairexcessiveboards",             "binary",    -1,  "mean",
  "pctrelativedirectors",             "pct100",    -1,  "mean",
  "ceosigboardsorceonumberboards",    "binary",    -1,  "mean",
  # Board Expertise
  "isdisclosedasfinancialexpert",     "binary",     1,  "max",   # >= 1 financial expert
  "nooffinancialexperts",             "calc_pct",   1,  "mean",
  # Board Refreshment
  "hastenurepolicy",                  "binary",     1,  "mean",
  # Committee Independence
  "ratioinddirectorsinauditcomm",     "pct100",     1,  "mean",
  "ratioinddirectorsincompcomm",      "pct100",     1,  "mean",
  "ratioinddirectorsinnomcommittee",  "pct100",     1,  "mean",
  # Conflict of Interest
  "hasrelativeincompservingasexec",   "binary",    -1,  "max",   # any director flagged
  "providesprofservice",              "binary",    -1,  "max",
  "hasboardinterlockrelwithcompexec", "binary",    -1,  "max",
  "noofrelativeempdirectors",         "calc_pct",  -1,  "mean",
  "noofinterlockdirectors",           "calc_pct",  -1,  "mean",
  # Controversy
  "companyenforcementaction",         "binary",    -1,  "mean",
  "companyinternalcontrolweakness",   "binary",    -1,  "mean",
  # Diversity & Human Capital
  "ratioofwomenonboarddqs",           "cutoff",     1,  "mean",
  "deidirectorskill",                 "has_any",    1,  "mean",
  # Emerging Risks Oversight
  "climatedirectorskill",             "calc_pct",   1,  "mean",
