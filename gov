  "supermajorityvotemerger",          "binary",    -1,  "mean",
  "pctcapitalconvenespecialmtg",      "pct100",    -1,  "mean",  # lower threshold = better
  "writtenconsent",                   "binary",     1,  "mean",
  # Sustainability Oversight (all "YES AS ADD ON")
  "comppolghgreduce",                 "binary",     1,  "mean",
  "stilticlimateperfmeasuredisclosure", "ordinal",  1,  "mean",
