# YES / NO flags that sit on director level: company = 1 if ANY director is flagged
spec$agg <- ifelse(spec$variable %in% c("isdisclosedasfinancialexpert",
                                        "hasrelativeincompservingasexec",
                                        "providesprofservice",
                                        "hasboardinterlockrelwithcompexec"),
                   "max", "mean")

# ---- WEIGHTS: equal weight per category, equal weight per variable in a category --
# only variables that are actually scored count, so all weights sum to 1
Gov_Weights <- Governance_Categ_adap %>%
  filter(variable %in% spec$variable) %>%
  distinct(variable, category) %>%
  mutate(weight_cat = 1 / n_distinct(category)) %>%
  group_by(category) %>%
  mutate(weight = weight_cat / n()) %>%
  ungroup()

# ---- HELPERS ---------------------------------------------------------------------
to_num <- function(x) {
  if (is.numeric(x) || is.logical(x)) return(as.numeric(x))
  y <- tolower(trimws(as.character(x)))
  out <- suppressWarnings(as.numeric(y))
  out[y %in% c("yes", "y", "true")] <- 1
  out[y %in% c("no", "n", "false")] <- 0
  out[y == "low"] <- 1
  out[y %in% c("medium", "moderate")] <- 2
  out[y == "high"] <- 3
  out[y %in% c("very high", "severe")] <- 4
  out
}

agg_fun <- function(v, how) {
  v <- v[!is.na(v)]
  if (length(v) == 0) return(NA_real_)
  if (how == "max") max(v) else mean(v)
}

# is a percentage stored as 0-1 or as 0-100?
pct_base <- function(x) if (all(is.na(x)) || max(x, na.rm = TRUE) <= 1) 1 else 100

minmax <- function(x) {
  if (all(is.na(x))) return(x)
  (x - min(x, na.rm = TRUE)) / (max(x, na.rm = TRUE) - min(x, na.rm = TRUE))
}

# ---- 1) DIRECTORS -> ONE ROW PER COMPANY -----------------------------------------
Gov_Firm <- Iss_Gov_Dir_Gen %>%
  group_by(isin) %>%
  summarise(
    issuername = first(issuername),
    board_size = n(),
    across(all_of(spec$variable[spec$agg == "mean"]), ~ agg_fun(to_num(.x), "mean")),
    across(all_of(spec$variable[spec$agg == "max"]),  ~ agg_fun(to_num(.x), "max")),
    .groups = "drop"
  )

# ---- 2) SCORE EVERY VARIABLE 0-100 (100 = best) ----------------------------------
Gov_Var_Scores <- Gov_Firm %>%
  pivot_longer(all_of(spec$variable), names_to = "variable", values_to = "value") %>%
  left_join(spec, by = "variable") %>%
  left_join(Gov_Weights, by = "variable") %>%
  group_by(variable) %>%
  mutate(
    p = pct_base(value),
    s = case_when(
      treat == "binary"   ~ value,
      treat == "has_any"  ~ as.numeric(value > 0),
      treat == "pct100"   ~ value / p,
      treat == "calc_pct" ~ value / board_size,
      treat == "cutoff"   ~ (value / p) / women_cutoff,
      treat == "decile"   ~ (value - 1) / 9,
      treat == "ordinal"  ~ minmax(value)
    )
  ) %>%
  ungroup() %>%
  mutate(
    s     = pmin(pmax(s, 0), 1),
    score = 100 * if_else(dir == -1, 1 - s, s)
  ) %>%
  select(isin, issuername, category, variable, treat, dir, agg, value, score, weight, weight_cat)

# ---- 3) CATEGORY SCORE + TOTAL SCORE ---------------------------------------------
# missing variables are skipped and the remaining weights re-normalised
Gov_Cat_Long <- Gov_Var_Scores %>%
  filter(!is.na(score)) %>%
  group_by(isin, issuername, category, weight_cat) %>%
  summarise(score = weighted.mean(score, weight), .groups = "drop")

Gov_Total <- Gov_Cat_Long %>%
  group_by(isin, issuername) %>%
  summarise(score_total = weighted.mean(score, weight_cat), .groups = "drop")

Gov_Cat_Scores <- Gov_Cat_Long %>%
  mutate(name = paste0("score_", gsub("[^a-z]+", "_", tolower(category)))) %>%
  select(isin, name, score) %>%
  pivot_wider(names_from = name, values_from = score) %>%
  left_join(Gov_Total %>% select(isin, score_total), by = "isin")

Gov_JOIN <- Iss_Gov_Dir_Gen %>% left_join(Gov_Cat_Scores, by = "isin")

